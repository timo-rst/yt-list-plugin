{
  "manifest_version": 3,
  "name": "Abo-Box Listenansicht für YouTube™",
  "version": "1.0.0",
  "description": "Bringt die klassische, übersichtliche Listenansicht für deine YouTube™ Abo-Box zurück mit Infobox-Vorschau und Thumbnail-Skalierung.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abo-Box Listenansicht für YouTube™"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_start"
    }
  ]
}
